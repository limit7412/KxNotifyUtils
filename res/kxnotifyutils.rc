// このファイルは UTF-8 で書く。
//
// rc.exe は BOM も #pragma code_page も無いファイルを、システムの ANSI コードページで読む。
// 日本語をそのまま書くとその解釈で UTF-16 へ変換され、exe のバージョン情報が文字化けする。
// BOM を付ける手もあるが、scripts/build.ps1 が -Version でこのファイルを書き戻すときに
// BOM 無しの UTF-8 で書くため、pragma で宣言するほうが噛み合う（issue #25）。
#pragma code_page(65001)

#include <winver.h>

// トレイと実行ファイルのアイコン。
// Tray::APP_ICON_RESOURCE がこの ID を LoadIconW に渡す。
1 ICON "kxnotifyutils.ico"

// exe のバージョン情報。
// 配布物は exe 1 ファイルで同梱の LICENSE を持たないため、ライセンスの所在をここにも書く。
1 VERSIONINFO
FILEVERSION 0, 1, 0, 0
PRODUCTVERSION 0, 1, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
{
  BLOCK "StringFileInfo"
  {
    BLOCK "041104b0"
    {
      VALUE "CompanyName", "limit7412\0"
      VALUE "FileDescription", "各種通知を XSOverlay へ中継する常駐アプリ\0"
      VALUE "FileVersion", "0.1.0\0"
      VALUE "InternalName", "KxNotifyUtils\0"
      VALUE "OriginalFilename", "KxNotifyUtils.exe\0"
      VALUE "ProductName", "KxNotifyUtils\0"
      VALUE "ProductVersion", "0.1.0\0"
      VALUE "LegalCopyright", "MIT License. Third-party notices are shown in the settings window.\0"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x411, 1200
  }
}
