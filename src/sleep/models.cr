# 睡眠時の停止（issue #54）。
module Sleep
  # 中継を止めている理由。
  #
  # 表示はどの入力で止まっているかを利用者が見分けるためにある。
  # 複数の入力が同時に睡眠中を示す場合に備え、表示に使う 1 つは並びの先にあるものを選ぶ。
  enum Reason
    # 止めていない。
    None
    # トレイからおやすみモードを始めている。
    Manual
    # スケジュールの時間帯に入っている。
    Schedule
    # OyasumiVR が睡眠モードに入っている。
    OyasumiVR
  end
end
